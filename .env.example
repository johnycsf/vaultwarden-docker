# Container engine: docker | podman (./manage.sh install will prompt)
CONTAINER_ENGINE=docker

# Image registry to pull images from. Default: docker.io
IMAGE_REGISTRY=docker.io

# Full URL people will use (include http:// or https://)
DOMAIN=http://192.168.1.50:8081
PORT=8081
SIGNUPS_ALLOWED=true
SHOW_PASSWORD_HINT=false
# Generated by ./install.sh — do not commit real tokens
ADMIN_TOKEN=CHANGE_ME
